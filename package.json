{
  "name": "sargento-luiz",
  "version": "1.5.0",
  "description": "SARGENTO LUIZ — top-down shooter pos-apocaliptico com progressao roguelite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "npm run build && cd dist && zip -qr ../sargento-luiz.zip . -x '*.DS_Store' && cd .. && echo 'pronto: sargento-luiz.zip'",
    "test": "vitest run",
    "test:watch": "vitest",
    "visual": "npm run build && node tools/visual.mjs",
    "sessao": "npm run build && node tools/session.mjs",
    "fases": "npm run build && node tools/fases-todas.mjs",
    "balance": "npm run build && node tools/balance-proof.mjs",
    "a5": "npm run build && node tools/a5-stall-proof.mjs",
    "diagnostico": "npm run build && node tools/sessao-diagnostico.mjs",
    "provas": "npm run build && node tools/visual.mjs && node tools/bullet-proof.mjs && node tools/tilemap-proof.mjs",
    "onda": "npm run build && node tools/onda-proof.mjs",
    "perks": "npm run build && node tools/perks-proof.mjs",
    "hud": "npm run build && node tools/hud-proof.mjs",
    "loja": "npm run build && node tools/loja-proof.mjs",
    "espaco": "npm run build && node tools/espaco-proof.mjs",
    "variedade": "npm run build && node tools/variedade-proof.mjs && node tools/variedade-check.mjs",
    "local2p": "npm run build && node tools/local2p-proof.mjs",
    "protect": "npm run build && node tools/castelo-wave-proof.mjs",
    "foguete": "npm run build && node tools/castelo-foguete-shot.mjs",
    "vulcao": "npm run build && node tools/vulcao-proof.mjs",
    "refinaria": "npm run build && node tools/refinaria-combustivel-proof.mjs",
    "cacador": "npm run build && node tools/cacador-proof.mjs",
    "bunker": "npm run build && node tools/bunker-entry-proof.mjs",
    "servicos": "npm run build && node tools/servicos-proof.mjs",
    "blur": "npm run build && node tools/blur-proof.mjs",
    "m2fluxo": "npm run build && node tools/m2-fluxo-proof.mjs",
    "voo": "npm run build && node tools/m4-voo-proof.mjs",
    "m5": "npm run build && node tools/m5-emocao-proof.mjs",
    "m3economia": "npm run build && node tools/m3-economia-proof.mjs",
    "tornado": "npm run build && node tools/m1-tornado-proof.mjs",
    "ambiente": "npm run build && node tools/m1-ambiente-proof.mjs",
    "ponte": "npm run build && node tools/m3-ponte-proof.mjs",
    "asfalto": "npm run build && node tools/m3-asfalto-proof.mjs",
    "carros": "npm run build && node tools/m3-carros-proof.mjs",
    "cenografia": "npm run build && node tools/m3-cenografia-proof.mjs",
    "hospital": "npm run build && node tools/m4-hospital-proof.mjs",
    "itch": "node tools/itch-fullscreen-proof.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
